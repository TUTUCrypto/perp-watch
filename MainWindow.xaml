<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="币安合约浮窗" Width="380" Height="320" MinWidth="350" MinHeight="240"
    Background="#10151F" Foreground="#E8EDF5" FontFamily="Microsoft YaHei UI" FontSize="12"
    WindowStyle="None" ResizeMode="CanResizeWithGrip">
  <Window.Resources>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
          <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb Background="#3B4A60"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" CornerRadius="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
        </Track>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="6"/></Trigger></Style.Triggers>
    </Style>

    <Style TargetType="Button">
      <Setter Property="Background" Value="#202A39"/><Setter Property="Foreground" Value="#E8EDF5"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,4"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="2,0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#354258"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value=".45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#202A39"/><Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#3B4A60"/><Setter Property="Padding" Value="8,6"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E8EDF5"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Margin" Value="0,6"/></Style>
  </Window.Resources>
  <Border BorderBrush="#344052" BorderThickness="1" Padding="9,8,9,7">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid x:Name="DragBar" Background="Transparent" Margin="0,0,0,7">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="PERP WATCH" Foreground="#F4C95D" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
          <Button x:Name="PinButton" Content="置顶" ToolTip="切换置顶"/>
          <Button x:Name="HideButton" Content="收起" ToolTip="恢复透明行情小格"/>
          <Button x:Name="CloseButton" Content="×" ToolTip="退出程序，停止监控"/>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1" Margin="0,0,0,7">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusLabel" Text="正在连接…" Foreground="#8D9DB4" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <Button Grid.Column="1" x:Name="AddButton" Content="＋ 添加合约" Background="#34402E" Foreground="#C8E99D"/>
      </Grid>
      <Grid Grid.Row="2" Margin="6,0,6,5">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="104"/><ColumnDefinition Width="68"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
        <TextBlock Text="合约" Foreground="#8D9DB4"/><TextBlock Grid.Column="1" Text="最新成交价" Foreground="#8D9DB4" HorizontalAlignment="Right"/>
        <TextBlock Grid.Column="2" Text="24h 涨跌" Foreground="#8D9DB4" HorizontalAlignment="Right"/>
      </Grid>
      <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Rows"/>
      </ScrollViewer>
      <Border Grid.Row="4" BorderBrush="#283344" BorderThickness="0,1,0,0" Padding="0,5,0,5" Margin="0,4,0,0">
        <TextBlock x:Name="RecentLabel" Text="双击合约打开 TradingView · 点 ⋯ 设置提醒" Foreground="#8D9DB4" TextTrimming="CharacterEllipsis" MaxHeight="18" FontSize="10"/>
      </Border>
      <Grid Grid.Row="5">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal"><Button x:Name="SoundButton" Content="声音 开"/><Button x:Name="LogButton" Content="提醒记录"/></StackPanel>
        <Button Grid.Column="1" x:Name="DockButton" Content="停靠位置" ToolTip="选择小格停靠方向"/>
      </Grid>
    </Grid>
  </Border>
</Window>
